{
  "remarks": "WARP + Xray noise",
  "log": { "loglevel": "warning" },
  "dns": {
    "servers": ["1.1.1.1", "1.0.0.1"]
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": { "auth": "noauth", "udp": true },
      "sniffing": { "enabled": true, "destOverride": ["http", "tls", "quic"] }
    }
  ],
  "outbounds": [
    {
      "tag": "warp",
      "protocol": "wireguard",
      "settings": {
        "secretKey": "WE7c0TrItjkqZC6zyz3E/C1LP8lc1U7F22TeVfYFs3M=",
        "address": [
          "172.16.0.2/32",
          "2606:4700:110:8600:4cc9:1b1d:4a5b:2782/128"
        ],
        "mtu": 1280,
        "peers": [
          {
            "publicKey": "bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=",
            "endpoint": "162.159.192.1:500",
            "keepAlive": 5,
            "allowedIPs": ["0.0.0.0/0", "::/0"]
          }
        ]
      },
      "streamSettings": {
        "sockopt": { "dialerProxy": "MMMnoise" }
      }
    },
    {
      "tag": "MMMnoise",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "AsIs",
        "noises": [
          { "type": "rand", "packet": "23-911", "delay": "1-3" },
          { "type": "rand", "packet": "23-911", "delay": "1-3" },
          { "type": "rand", "packet": "23-911", "delay": "1-3" },
          { "type": "rand", "packet": "23-911", "delay": "1-3" },
          { "type": "rand", "packet": "23-911", "delay": "1-3" },
          { "type": "rand", "packet": "23-911", "delay": "1-3" },
          { "type": "rand", "packet": "23-911", "delay": "1-3" },
          { "type": "rand", "packet": "23-911", "delay": "1-3" }
        ]
      }
    },
    { "tag": "direct", "protocol": "freedom" },
    { "tag": "block", "protocol": "blackhole" }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      { "type": "field", "ip": ["geoip:private"], "outboundTag": "direct" },
      { "type": "field", "network": "tcp,udp", "outboundTag": "warp" }
    ]
  }
}
